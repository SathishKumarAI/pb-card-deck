# Optional: connect this deployment to a Supabase project so players can choose an
# account. Leave BOTH unset and the app is the local-first one - no account UI, and
# @supabase/supabase-js is never even downloaded.
#
# Copy to .env.local (git-ignored) and fill in. Full setup: docs/SUPABASE-SETUP.md

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NEXT_PUBLIC_ means "shipped to every visitor in the JavaScript bundle". That is
# correct for the two variables above - the publishable key carries no privileges
# of its own and row-level security decides everything.
#
# It is WRONG for anything else. A secret key (sb_secret_... / service_role) must
# never appear here, in .env.local, or in Vercel's project settings for this app.
# The only place one is used is a local run of the RLS suite, which reads it from
# `.env.rls.local` at the REPO ROOT - a separate git-ignored file, so nothing the app
# loads can see it. See docs/SUPABASE-SETUP.md.
